# Every setting the backend binaries read, with its default where it has one.
# Copy to .env for local development; the binaries read .env on start. A
# deployment sets the same names in its environment (README, "Deploying").
# A setting left empty counts as not set.

# ---- Database ---------------------------------------------------------------

# The two roles keep the names exchange (the schema owner) and exchange_app
# (the application role): the migrations grant to exchange_app by name, and a
# migration that has been applied is never edited (backend/migrations/README.md).

# Connection used by the api and worker processes: the restricted application
# role, which cannot rewrite history (DESIGN.md §13.2). Required.
DATABASE_URL=postgres://exchange_app:exchange_app@127.0.0.1:5432/yuppers

# Connection used by the migrate binary: the schema owner. Required by
# migrate, which falls back to DATABASE_URL in development.
MIGRATION_DATABASE_URL=postgres://exchange:exchange@127.0.0.1:5432/yuppers

# ---- The service ------------------------------------------------------------

# Where the web app is served from, without a trailing slash. Cookie sessions
# are honored only for requests from this origin, and notification emails
# link into it. Required. When the API serves the web app itself (WEB_DIR),
# this is the API's own public origin; with HTTPS, responses carry HSTS.
WEB_ORIGIN=http://localhost:5173

# Keys the stored hashes of one-time codes. Required, at least 32 bytes;
# generate a real one for any shared environment, for example with
# `openssl rand -hex 32`, and never commit it.
APP_SECRET=development-only-secret-do-not-use-anywhere-else

# Address and port the API listens on. Default 127.0.0.1:8080. The container
# image sets 0.0.0.0:8080.
BIND_ADDR=127.0.0.1:8080

# A directory holding the built web app (`npm run build:web` writes
# apps/web/dist) for the API to serve alongside itself: each language's entry
# page at /{language}/i, the app's page for every other unknown path, hashed
# assets cached for a year. Default: none, the API serves no pages. The
# container image sets /srv/web.
WEB_DIR=

# Which request header, if any, names the requester's network address, and how
# many proxies in a row add to it. Default: none, the connection's peer is the
# requester, and any such header is ignored. Behind one reverse proxy or a
# CDN, name its header (X-Forwarded-For, CF-Connecting-IP, Fly-Client-IP, ...);
# with a chain of proxies that each append to X-Forwarded-For, say how many,
# so the right entry is taken and one a client sent itself is not (default 1
# once a header is named). The RFC 7239 `Forwarded` header is not read and is
# refused. Without a header the API warns at start, and with one it warns
# about once a minute while the header is missing or unreadable: such
# requests are all counted as the proxy's address. The address is recorded
# with each signature (DESIGN.md §8).
TRUSTED_PROXY_HEADER=
TRUSTED_PROXIES=

# Limits on signing in (DESIGN.md §8), counted against the requester's
# network address (above; an IPv6 requester by its /64) and against the email
# address or phone number.
# Each is a whole number of 1 or more. Zero is refused at start, not read as
# "no limit", and no value turns a limit off: to get one out of the way, as
# the end-to-end tests and the load check do, set it high. Behind a proxy,
# name its header above, or every requester shares the proxy's address.
# Sign-in codes one address may ask for per hour. Default 10.
SIGN_IN_CODE_REQUESTS_PER_ADDRESS_PER_HOUR=
# Wrong codes one address may offer per hour, at email addresses or phone
# numbers that have a live code. Past it a wrong code is refused with
# TOO_MANY_REQUESTS; a right one still works. Default 30.
SIGN_IN_FAILED_GUESSES_PER_ADDRESS_PER_HOUR=
# Wrong codes one email address or phone number may take per UTC day, after
# which even the right code is refused until the day ends. Default 20.
SIGN_IN_FAILED_GUESSES_PER_IDENTIFIER_PER_DAY=

# Log level and filter (tracing_subscriber EnvFilter syntax). Default info.
RUST_LOG=info

# How each log line is written, for every binary. Default text.
#   text  one readable line per event
#   json  one JSON object per line, for a log collector
# docs/operations.md lists the fields. No log line holds a request body, a
# query string, a token, a cookie, a one-time code, an email address or a
# phone number, except what the development deliveries below write.
LOG_FORMAT=text

# Where the api, or the worker, serves its metrics (Prometheus text format,
# GET /metrics), as an address and port such as 0.0.0.0:9100. Default: none,
# no metrics listener. Always a port of its own, never the API's, and one a
# deployment exposes only to whatever collects the metrics. The api and the
# worker each read it; give each its own when they share a host.
METRICS_ADDR=

# ---- Delivery ---------------------------------------------------------------

# How one-time codes reach people. Required, no default, so the development
# delivery is never used by accident:
#   log   writes each code to the API's log, which is where you read it to
#         sign in. Development only.
#   smtp  emails it through the SMTP server below. Codes go by email only;
#         SMS delivery is not built.
CODE_DELIVERY=log

# How notification emails reach people. Required, no default, for the same
# reason:
#   log   the worker writes each email to its log. Development only.
#   smtp  the worker sends it through the SMTP server below.
NOTIFICATION_DELIVERY=log

# The SMTP server, used when either delivery above is `smtp`. Nearly every
# email provider offers SMTP; these are the values it gives you.
# Required then: SMTP_HOST and SMTP_FROM.
SMTP_HOST=
# How the connection is protected. Default tls.
#   tls       TLS from the first byte (SMTPS), usually port 465
#   starttls  plain connection upgraded with STARTTLS before anything else is
#             said, usually port 587; a server that cannot upgrade is refused
#   none      plain text throughout: a relay on this host or a test server,
#             never a server reached over a network. Refused at startup
#             unless SMTP_HOST is this host (localhost, 127.0.0.0/8, ::1) and
#             no SMTP_USERNAME or SMTP_PASSWORD is set.
SMTP_TLS=tls
# `true` lets SMTP_TLS=none reach another host, or send credentials, in plain
# text: for a test server only, such as one in a container next to this one.
# Default false.
SMTP_ALLOW_PLAINTEXT_REMOTE=
# Default: the usual port for SMTP_TLS (465, 587 or 25).
SMTP_PORT=
# Both or neither. The password is never written to a log or an error.
SMTP_USERNAME=
SMTP_PASSWORD=
# The sender, with an optional name: `Yuppers <no-reply@example.com>`.
SMTP_FROM=

# The oldest build of each client that may still change anything. A client
# below its minimum is told to update, and its changes are refused with
# CLIENT_TOO_OLD. Dotted whole numbers such as 1.4.0; unset or empty means no
# minimum, which is the default.
#MIN_CLIENT_VERSION_WEB=
#MIN_CLIENT_VERSION_IOS=
#MIN_CLIENT_VERSION_ANDROID=

# Universal links (iOS) and app links (Android): which apps may open the
# invitation links and exchange pages (/exchanges/...) of WEB_ORIGIN in place
# of the browser. Served at
# /.well-known/apple-app-site-association and /.well-known/assetlinks.json;
# a file whose setting is unset is not served. A value that is not one stops
# the API at start. See docs/mobile-release.md.
# APPLE_APP_ID: the team ID and bundle ID, such as ABCDE12345.app.yuppers;
# several may be given, separated by commas.
#APPLE_APP_ID=
# The SHA-256 fingerprints of the certificates the Android app is signed
# with (the Play app signing key, and the upload key for internal builds),
# as colon-separated hex pairs, separated by commas.
#ANDROID_SHA256_CERT_FINGERPRINTS=
# Default: app.yuppers.
#ANDROID_PACKAGE=
