# Copy to .env for local development. The backend binaries read it on start.

# Connection used by the api and worker processes: the restricted application
# role, which cannot rewrite history (DESIGN.md §13.2).
DATABASE_URL=postgres://exchange_app:exchange_app@127.0.0.1:5432/exchange

# Connection used by `cargo run --bin migrate`: the schema owner.
MIGRATION_DATABASE_URL=postgres://exchange:exchange@127.0.0.1:5432/exchange

BIND_ADDR=127.0.0.1:8080
RUST_LOG=info
