# Copy to .env for local development. The backend binaries read it on start.

# Connection used by the api and worker processes: the restricted application
# role, which cannot rewrite history (DESIGN.md §13.2).
DATABASE_URL=postgres://exchange_app:exchange_app@127.0.0.1:5432/exchange

# Connection used by `cargo run --bin migrate`: the schema owner.
MIGRATION_DATABASE_URL=postgres://exchange:exchange@127.0.0.1:5432/exchange

# Where the web app is served from. Cookie sessions are honored only for
# requests from this origin.
WEB_ORIGIN=http://localhost:5173

# Keys the stored hashes of one-time codes. At least 32 bytes; generate a real
# one for any shared environment, for example with `openssl rand -hex 32`.
APP_SECRET=development-only-secret-do-not-use-anywhere-else

# How one-time codes reach people. `log` writes them to the service log and is
# for development only; there is no default, so it is never used by accident.
CODE_DELIVERY=log

# How notification emails reach people. `log` writes them to the worker's log
# and is for development only; there is no default, for the same reason.
NOTIFICATION_DELIVERY=log

BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

# The oldest build of each client that may still change anything. A client
# below its minimum is told to update, and its changes are refused with
# CLIENT_TOO_OLD. Dotted whole numbers such as 1.4.0; unset or empty means no
# minimum, which is the default.
#MIN_CLIENT_VERSION_WEB=
#MIN_CLIENT_VERSION_IOS=
#MIN_CLIENT_VERSION_ANDROID=
