# What the image build never needs. Secrets and local state first, in any
# directory: an app's own .env is as secret as the root one.
**/.env
**/.env.*
!**/.env.example
.git
.github
.claude

# Build output and dependencies are produced inside the build.
node_modules
**/node_modules
backend/target
apps/web/dist
apps/mobile/*
!apps/mobile/package.json
.expo
*.tsbuildinfo
*.log
.DS_Store
